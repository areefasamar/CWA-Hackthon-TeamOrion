# Karachi Transit AI — Backend Environment Configuration
PORT=8000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-optional-gemini-key

# LLM provider — put EITHER key here; the backend auto-detects the provider:
#   xai-...  -> xAI Grok (https://console.x.ai)
#   gsk_...  -> Groq    (https://console.groq.com)
# Model names (grok-4-fast / openai/gpt-oss-120b / whisper-large-v3) are
# hardcoded in services/grok_client.py.
XAI_API_KEY=
